@using IdentityChatMail.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager

@{
    Layout = null;

    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Identity Chat & Mail</title>

    <link rel="icon"
          type="image/png"
          sizes="16x16"
          href="/master/images/favicon.png" />

    <link href="/master/css/style.css" rel="stylesheet" />

    <style>
            html,
            body {
                width: 100%;
                min-height: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background-color: #f3f3f9;
            }

            #main-wrapper {
                width: 100%;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Temadan gelen sol boşluğu kaldırır */
            .content-body {
                width: 100% !important;
                min-height: calc(100vh - 70px);
                margin-left: 0 !important;
                padding: 20px;
                flex: 1;
            }

            .message-container {
                width: 100%;
                min-height: calc(100vh - 140px);
                padding: 0;
            }

            .message-card {
                width: 100%;
                min-height: calc(100vh - 140px);
                margin: 0;
            }

            .message-card-body {
                width: 100%;
                min-height: calc(100vh - 140px);
                display: flex;
                padding: 0;
            }

            /* Sol menü */
            .email-left-box {
                width: 25% !important;
                min-width: 230px;
                padding: 25px;
                border-right: 1px solid #e5e5e5;
                float: none !important;
            }

            /* Sağ içerik */
            .email-right-box {
                width: 75% !important;
                min-height: calc(100vh - 140px);
                padding: 25px;
                margin-left: 0 !important;
                float: none !important;
                display: flex;
                flex-direction: column;
            }

            .email-list {
                width: 100%;
                flex: 1;
            }

            .footer {
                width: 100%;
                margin-left: 0 !important;
            }

            /* Tablet ve telefon görünümü */
            @@media (max-width: 768px) {
                .content-body {
                    padding: 10px;
                }

                .message-card-body {
                    flex-direction: column;
                }

                .email-left-box,
                .email-right-box {
                    width: 100% !important;
                    min-width: 100%;
                }

                .email-left-box {
                    border-right: none;
                    border-bottom: 1px solid #e5e5e5;
                }
            }
            /* Sol menü ve kullanıcı kartı */
            .email-left-box {
                background: linear-gradient(180deg, #ffffff 0%, #fbfbff 100%);
            }

            .sidebar-profile {
                overflow: hidden;
                width: 100%;
                border: 1px solid rgba(113, 108, 255, 0.12);
                border-radius: 16px;
                background: linear-gradient(135deg, #625df5 0%, #8b6df6 55%, #a56cf2 100%);
                box-shadow: 0 10px 24px rgba(98, 93, 245, 0.22);
                color: #ffffff;
            }

            .sidebar-profile-main {
                display: flex;
                align-items: center;
                padding: 17px 15px 14px;
            }

            .sidebar-avatar-wrapper {
                position: relative;
                width: 58px;
                height: 58px;
                flex-shrink: 0;
            }

            .sidebar-avatar,
            .sidebar-avatar-placeholder {
                width: 58px;
                height: 58px;
                border: 3px solid rgba(255, 255, 255, 0.9);
                border-radius: 50%;
                background-color: #ffffff;
                box-shadow: 0 5px 14px rgba(50, 37, 135, 0.22);
            }

            .sidebar-avatar {
                object-fit: cover;
            }

            .sidebar-avatar-placeholder {
                display: flex;
                align-items: center;
                justify-content: center;
                color: #716cff;
                font-size: 24px;
            }

            .sidebar-online-dot {
                position: absolute;
                right: 0;
                bottom: 2px;
                width: 14px;
                height: 14px;
                border: 3px solid #ffffff;
                border-radius: 50%;
                background-color: #32d583;
            }

            .sidebar-user-info {
                min-width: 0;
                flex: 1;
                margin-left: 12px;
            }

            .sidebar-user-name {
                display: block;
                overflow: hidden;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                line-height: 1.3;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .sidebar-user-status {
                display: block;
                margin-top: 4px;
                color: rgba(255, 255, 255, 0.78);
                font-size: 12px;
            }

            .sidebar-logout {
                width: 36px;
                height: 36px;
                display: flex;
                flex-shrink: 0;
                align-items: center;
                justify-content: center;
                margin-left: 8px;
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 10px;
                background-color: rgba(255, 255, 255, 0.14);
                color: #ffffff;
                transition: all 0.2s ease;
            }

                .sidebar-logout:hover {
                    border-color: #ff696f;
                    background-color: #ff5c62;
                    color: #ffffff;
                    text-decoration: none;
                    transform: translateY(-1px);
                }

            .sidebar-profile-email {
                overflow: hidden;
                padding: 10px 15px;
                border-top: 1px solid rgba(255, 255, 255, 0.18);
                background-color: rgba(32, 24, 100, 0.12);
                color: rgba(255, 255, 255, 0.88);
                font-size: 12px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

                .sidebar-profile-email i {
                    margin-right: 7px;
                }

            .email-left-box > .btn-primary.btn-block {
                padding: 12px 16px;
                border: none;
                border-radius: 11px;
                background: linear-gradient(135deg, #625df5, #8079ff);
                box-shadow: 0 7px 16px rgba(98, 93, 245, 0.20);
                font-weight: 600;
                transition: all 0.2s ease;
            }

                .email-left-box > .btn-primary.btn-block:hover {
                    box-shadow: 0 10px 20px rgba(98, 93, 245, 0.28);
                    transform: translateY(-1px);
                }

            .email-left-box .mail-list a {
                display: flex;
                align-items: center;
                margin-bottom: 5px;
                padding: 11px 13px !important;
                border-radius: 10px;
                color: #747486;
                transition: all 0.2s ease;
            }

                .email-left-box .mail-list a:hover {
                    background-color: #f0efff;
                    color: #625df5;
                    text-decoration: none;
                    transform: translateX(3px);
                }

                .email-left-box .mail-list a i {
                    width: 23px;
                    margin-right: 8px;
                    color: #8a899c;
                    font-size: 16px;
                    text-align: center;
                }

                .email-left-box .mail-list a:hover i {
                    color: #625df5;
                }

    </style>

</head>

<body>

    <!-- Preloader -->
    <div id="preloader">
        <div class="loader">
            <svg class="circular" viewBox="25 25 50 50">
                <circle class="path"
                        cx="50"
                        cy="50"
                        r="20"
                        fill="none"
                        stroke-width="3"
                        stroke-miterlimit="10">
                </circle>
            </svg>
        </div>
    </div>

    <!-- Main Wrapper -->
    <div id="main-wrapper">

        <!-- Content Body -->
        <div class="content-body">

            <div class="container-fluid message-container">
                <div class="row">
                    <div class="col-12">

                        <div class="card message-card">
                            <div class="card-body message-card-body">

                                <!-- Sol Menü -->
                                <div class="email-left-box">

                                    <div class="mb-3">

                                        @if (User.Identity?.IsAuthenticated == true && currentUser != null)
                                        {
                                            <div class="sidebar-profile">

                                                <div class="sidebar-profile-main">

                                                    <div class="sidebar-avatar-wrapper">

                                                        @if (!string.IsNullOrWhiteSpace(currentUser.ProfilImageUrl))
                                                        {
                                                            <img src="@currentUser.ProfilImageUrl"
                                                                 class="sidebar-avatar"
                                                                 alt="@currentUser.Name profil fotoğrafı" />
                                                        }
                                                        else
                                                        {
                                                            <div class="sidebar-avatar-placeholder">
                                                                <i class="fa fa-user"></i>
                                                            </div>
                                                        }

                                                        <span class="sidebar-online-dot"></span>

                                                    </div>

                                                    <div class="sidebar-user-info">

                                                        <strong class="sidebar-user-name">
                                                            @if (!string.IsNullOrWhiteSpace(currentUser.Name) ||
                                                                 !string.IsNullOrWhiteSpace(currentUser.Surname))
                                                            {
                                                                @($"{currentUser.Name} {currentUser.Surname}")
                                                            }
                                                            else
                                                            {
                                                                @currentUser.UserName
                                                            }
                                                        </strong>

                                                        <span class="sidebar-user-status">
                                                            Çevrimiçi
                                                        </span>

                                                    </div>

                                                    <a asp-controller="Login"
                                                       asp-action="Logout"
                                                       class="sidebar-logout"
                                                       title="Çıkış Yap">

                                                        <i class="fa fa-sign-out"></i>
                                                    </a>

                                                </div>

                                                <div class="sidebar-profile-email"
                                                     title="@currentUser.Email">

                                                    <i class="fa fa-envelope"></i>
                                                    @currentUser.Email
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <a asp-controller="Login"
                                               asp-action="UserLogin"
                                               class="btn btn-success btn-block">

                                                <i class="fa fa-sign-in mr-1"></i>
                                                Giriş Yap
                                            </a>
                                        }

                                    </div>

                                    <a asp-controller="Message"
                                       asp-action="CreateMessage"
                                       class="btn btn-primary btn-block">
                                        <i class="fa fa-plus mr-2"></i>
                                        Yeni Mesaj Oluştur
                                    </a>


                                    <div class="mail-list mt-4">

                                        <a asp-controller="Message"
                                           asp-action="Inbox"
                                           class="list-group-item border-0 text-primary p-r-0">

                                            <i class="fa fa-inbox font-18 align-middle mr-2"></i>

                                            <b>Gelen Kutusu</b>

                                            @*  <span class="badge badge-primary badge-sm float-right m-t-5">
                                                198
                                            </span> *@
                                        </a>

                                        <a asp-controller="Message"
                                           asp-action="Sendbox"
                                           class="list-group-item border-0 p-r-0">

                                            <i class="fa fa-paper-plane font-18 align-middle mr-2"></i>
                                            Gönderilenler
                                        </a>

                                        <a asp-controller="Message" asp-action="Important">
                                            <i class="ti-star"></i>
                                            Önemli
                                        </a>


                                        <a asp-controller="Message" asp-action="Drafts">
                                            <i class="ti-save"></i>
                                            <span class="nav-text">Taslaklar</span>
                                        </a>

                                        <a asp-controller="Message" asp-action="Trash">
                                            <i class="ti-trash"></i>
                                            <span class="nav-text">Çöp Kutusu</span>
                                        </a>

                                    </div>
                                </div>

                                <!-- Sağ İçerik -->
                                <div class="email-right-box">

                                    <!-- Sayfaların geleceği alan -->
                                    <div class="email-list mt-3">
                                        @RenderBody()
                                    </div>

                                   

                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="copyright">
                <p>
                    Copyright &copy;
                    Designed &amp; Developed by
                    <a href="#">Identity Chat &amp; Mail</a>
                    2026
                </p>
            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="/master/plugins/common/common.min.js"></script>
    <script src="/master/js/custom.min.js"></script>
    <script src="/master/js/settings.js"></script>
    <script src="/master/js/gleek.js"></script>
    <script src="/master/js/styleSwitcher.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @{
        var alertType = TempData["Success"] != null ? "success"
                      : TempData["Error"] != null ? "error"
                      : TempData["Warning"] != null ? "warning"
                      : TempData["Info"] != null ? "info"
                      : null;

        var alertMessage = TempData["Success"] ?? TempData["Error"] ?? TempData["Warning"] ?? TempData["Info"];
    }

    @if (alertType != null)
    {
        <script>
                Swal.fire({
                    icon: '@alertType',
                    title: '@alertMessage',
                    timer: 2000,
                    timerProgressBar: true,
                    showConfirmButton: false
                });
        </script>
    }


</body>

</html>
