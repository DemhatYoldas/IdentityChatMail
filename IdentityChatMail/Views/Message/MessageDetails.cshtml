@model IdentityChatMail.Entities.Message

@{
    Layout = "_MessageLayout";

    var userEmail = ViewBag.CurrentUserEmail as string;

    var isImportant = Model.ReceiverEmail == userEmail
        ? Model.ReceiverIsImportant
        : Model.SenderIsImportant;
}

<div class="read-content">

    <div class="media pt-5">

        <img class="mr-3 rounded-circle"
             src="@ViewBag.ProfilImageUrl"
             width="60"
             height="60"
             alt="Kullanıcı avatarı" />

        <div class="media-body">

            <h5 class="m-b-3">
                @(ViewBag.Name ?? "AD YOK") @(ViewBag.Surname ?? "SOYAD YOK")
            </h5>

            <p class="m-b-2">
                @Model.SendDate.ToString(
                    "dd MMMM yyyy",
                    System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
            </p>

        </div>
    </div>

    <hr />

    <div class="media mb-4 mt-1">
        <div class="media-body">

            <span class="float-right">
                @Model.SendDate.ToString("HH:mm")
            </span>

            <h4 class="m-0 text-primary">
                @Model.Subject
            </h4>

            <small class="text-muted">
                @Model.ReceiverEmail
            </small>

        </div>
    </div>

    <p>
        @Model.MessageDetail
    </p>

    <hr />

    <a href="@Url.Action(
                                     "ToggleImportant",
                                     "Message",
                                     new { id = Model.MessageId })"
       class="btn @(isImportant ? "btn-warning" : "btn-outline-warning")">

        <i class="ti-star"></i>

        @(isImportant ? "Önemden Çıkar" : "Önemli Yap")
    </a>
    <br />
    <br />
    <a href="@Url.Action(
                                 "MoveToTrash",
                                 "Message",
                                 new { id = Model.MessageId })"
       class="btn btn-outline-danger"
       onclick="return confirm('Mesaj çöp kutusuna taşınsın mı?')">

        <i class="ti-trash"></i>
        Çöp Kutusuna Taşı
    </a>


</div>