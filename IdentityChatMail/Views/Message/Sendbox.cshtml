@model List<IdentityChatMail.Entities.Message>

@{
    Layout = "_MessageLayout";
}





<div class="email-list m-t-15">
    <div class="email-list m-t-15">

        @foreach (var item in Model)
        {
            <div class="message">
                <a href="@Url.Action("MessageDetails", "Message", new { id = item.MessageId })">
                    <div class="col-mail col-mail-1">
                        <div class="email-checkbox">
                            <input type="checkbox" id="chk_@item.MessageId">
                            <label class="toggle" for="chk_@item.MessageId"></label>
                        </div>
                        <span class="star-toggle ti-star"></span>
                    </div>

                    <div class="col-mail col-mail-2">
                        <div class="subject">
                            @item.Subject
                        </div>
                        <div class="date">
                            @item.SendDate.ToString("dd MMMM ", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

</div>