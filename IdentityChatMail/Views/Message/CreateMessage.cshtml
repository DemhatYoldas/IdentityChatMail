@model IdentityChatMail.Entities.Message

@{
    Layout = "_MessageLayout";
}


<div class="compose-content mt-3">

    <form asp-controller="Message"
          asp-action="CreateMessage"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">
            <input type="email"
                   class="form-control bg-transparent"
                   placeholder="E-posta adresi"
                   asp-for="ReceiverEmail" />

            <span asp-validation-for="ReceiverEmail"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <input type="text"
                   class="form-control bg-transparent"
                   placeholder="Konu"
                   asp-for="Subject" />

            <span asp-validation-for="Subject"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <textarea class="textarea_editor form-control bg-light"
                      rows="15"
                      asp-for="MessageDetail"
                      placeholder="Mesajınızı yazınız...">
            </textarea>

            <span asp-validation-for="MessageDetail"
                  class="text-danger">
            </span>
        </div>

        <div class="d-flex mt-3">

            <button class="btn btn-primary mr-2"
                    type="submit">
                <i class="fa fa-paper-plane mr-1"></i>
                Gönder
            </button>

            <a asp-controller="Message"
               asp-action="Inbox"
               class="btn btn-dark">
                <i class="ti-close mr-1"></i>
                İptal
            </a>

        </div>

    </form>

</div>

