@model List<IdentityChatMail.Entities.Message>

@{
    Layout = "_MessageLayout";
}

<div class="message-list">

    @foreach (var item in Model)
    {
        <div class="message">

            <a href="@Url.Action("MessageDetails", "Message", new { id = item.MessageId })">

                <div class="col-mail col-mail-1">

                    <span class="star-toggle ti-star"
                          style="color:#ffc107;">
                    </span>

                </div>

                <div class="col-mail col-mail-2">

                    <div class="subject">
                        @item.Subject
                    </div>

                    <div class="date">
                        @item.SendDate.ToString(
                            "dd MMMM",
                            System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
                    </div>

                </div>

            </a>

        </div>
    }

</div>