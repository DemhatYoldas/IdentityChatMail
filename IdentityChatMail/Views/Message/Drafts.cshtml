@model List<IdentityChatMail.Entities.Message>

@{
    Layout = "_MessageLayout";
}

<div class="email-list m-t-15">

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Kaydedilmiş taslak bulunmuyor.
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="message">

                <a asp-controller="Message"
                   asp-action="MessageDetails"
                   asp-route-id="@item.MessageId">

                    <div class="col-mail col-mail-1">
                        <span class="ti-save text-warning"></span>
                    </div>

                    <div class="col-mail col-mail-2">

                        <div class="subject">
                            @(string.IsNullOrWhiteSpace(item.Subject)
                                ? "(Konu bulunmuyor)"
                                : item.Subject)

                            <span class="text-muted">
                                — @(string.IsNullOrWhiteSpace(item.ReceiverEmail)
                                                                    ? "Alıcı belirtilmedi"
                                                                    : item.ReceiverEmail)
                            </span>
                        </div>

                        <div class="date">
                            @item.SendDate.ToString(
                                "dd MMMM",
                                System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
                        </div>

                    </div>

                </a>

            </div>
        }
    }

</div>